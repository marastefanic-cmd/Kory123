+  // ═══════════ ramp deficit — dock the DAMAGE lost to the 0→3 stack ramp ═══════════
+  // The opener (and each post-gap re-ramp) casts the first 3 Arcane Blasts at 0/1/2 stacks — slower than the
+  // steady 3-stack cast the integral above assumed — so FEWER casts flow through the ramp region than it
+  // counted. The COUNT deficit is exactly 1.333 casts per ramp-start and HASTE-INDEPENDENT below the GCD
+  // floor (extra ramp time 2.0/m ÷ steady cast 1.5/m = 1.333 — the m cancels), so this correction leaves the
+  // interval / cast-count valuation — and thus haste-buff placement-independence (RULES §3) — UNTOUCHED. It
+  // subtracts the DAMAGE of those phantom casts, weighted by the local damage multiplier: a DAMAGE buff
+  // (Icon/AP/gem) sitting on the ramp is docked (its SP/AP is spread over fewer real casts); a haste buff is
+  // not. Above the floor the ramp casts cap too, so each deficit → 0 (the dock vanishes by ~789 rating),
+  // matching the sim. This is the ONE ramp effect that survives: modelling the ramp inside `interval` instead
+  // would over/under-credit pull haste (see the steady-state note above) — here `interval` is never touched.
+  const segAt = tt => {
+    if (!segs) return null;
+    for (let i = 0; i < segs.length; i++) if (tt >= segs[i].start && tt < segs[i].end) return segs[i];
+    return null;
+  };
+  const rampStarts = [0];
+  if (segs) for (const sg of segs) {
+    // AB stacks fall off DEBUFF_DUR after the last AB; a gap in AB casting (intermission, or AoE = Arcane
+    // Explosion spam, no AB) at least that long re-ramps on resume. Burn phases are still AB — no reset.
+    if ((sg.type === "intermission" || sg.type === "aoe") && sg.end > 0 && sg.end < cfg.T && (sg.end - sg.start) >= g.AB.DEBUFF_DUR) rampStarts.push(sg.end);
+  }
+  for (const R of rampStarts) {
+    let tt = R;
+    for (let k = 0; k < g.AB.MAX_STACKS; k++) {
+      const segB = segAt(tt);
+      if (segB && (segB.type === "intermission" || segB.type === "aoe")) break; // not AB casting here — no ramp
+      const st = scanAt(tt, segB);
+      const gcd = Math.max(g.GCD_FLOOR, g.GCD_BASE / st.multDn2);
+      const intRamp = Math.max((g.AB.BASE_CAST - g.AB.STACK_CAST_REDUCTION * k) / st.multDn2, gcd);
+      const intSS = Math.max((g.AB.BASE_CAST - g.AB.STACK_CAST_REDUCTION * g.AB.MAX_STACKS) / st.multDn2, gcd);
+      const deficit = intRamp / intSS - 1; // phantom casts over-counted in this sub-interval (≥0; →0 when capped)
+      // Sample the phantom cast's damage at the ramp cast's COMPLETION time — damage lands on completion in
+      // the game. Midpoint sampling was wrong: it let a haste buff that compresses the ramp slide a ramp
+      // cast's midpoint out of a damage window, re-creating the phantom "haste compresses the ramp" credit
+      // (the failure the steady-state note above documents). At completion time the dock is (near-)invariant
+      // to haste placement, so it prices only WHAT sits on the ramp, not how fast the ramp ran.
+      const endR = tt + intRamp;
+      if (deficit > 1e-9 && endR < cfg.T) {
+        const d = deficit * scanAt(endR, segAt(endR)).dmg2; // damage those phantom casts carry (SP/AP on the ramp)
+        total -= d;
+        if (endR <= cfg.T - KW) totalEarly -= d;
+        robust -= d * Math.min(1, Math.max(0, (cfg.T + KW - endR) / (2 * KW)));
+      }
+      tt += intRamp;
+    }
+  }
   return { total, totalEarly, robust, castCount, gcdCappedTime, casts, actEff, dps: total / cfg.T };
